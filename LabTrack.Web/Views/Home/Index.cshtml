@{
    ViewData["Title"] = "Bienvenido a LabTrack";

    var usuarioNombre = Context.Session.GetString("UsuarioNombre");
    var usuarioRol = Context.Session.GetString("UsuarioRol");
    bool estaAutenticado = !string.IsNullOrEmpty(usuarioRol);
}

<div class="container py-4">
    <!-- Hero Section / Presentación Principal -->
    <div class="p-5 mb-5 rounded-4 shadow-sm hero-section text-white text-center position-relative overflow-hidden">
        <div class="position-relative z-1 py-4">
            <span class="badge bg-white text-primary fw-semibold px-3 py-2 rounded-pill mb-3 shadow-sm">
                <i class="bi bi-cpu-fill me-1"></i> Sistema Oficial de Gestión de Laboratorios
            </span>
            <h1 class="display-4 fw-bold mb-3">LabTrack</h1>
            <p class="lead fs-4 mb-4 mx-auto" style="max-width: 750px;">
                Plataforma tecnológica centralizada para el control analítico, inventario automatizado y programación de reservas de equipos en los laboratorios de ingeniería.
            </p>

            <!-- Acciones según estado de autenticación -->
            <div class="d-flex flex-column align-items-center gap-3">
                @if (!estaAutenticado)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg fw-semibold px-4 shadow rounded-3 text-primary" style="min-width: 260px;">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg fw-semibold px-4 rounded-3" style="min-width: 260px;">
                        <i class="bi bi-person-plus me-2"></i> Registrarse
                    </a>
                }
                else if (usuarioRol == "Encargado")
                {
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a asp-controller="Equipos" asp-action="Index" class="btn btn-light btn-lg fw-semibold px-4 shadow rounded-3 text-primary">
                            <i class="bi bi-tools me-2"></i> Ir a Gestión de Equipos
                        </a>
                        <a asp-controller="GestionReservas" asp-action="Index" class="btn btn-outline-light btn-lg fw-semibold px-4 rounded-3">
                            <i class="bi bi-calendar2-check me-2"></i> Bandeja de Reservas
                        </a>
                    </div>
                }
                else if (usuarioRol == "Estudiante")
                {
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-light btn-lg fw-semibold px-4 shadow rounded-3 text-success">
                            <i class="bi bi-grid-3x3-gap-fill me-2"></i> Explorar Catálogo y Reservar
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sección de Características / Qué ofrece LabTrack -->
    <div class="row text-center mb-5">
        <div class="col-12 mb-4">
            <h2 class="fw-bold text-dark">Pilares del Sistema</h2>
            <p class="text-muted">Diseñado bajo estándares de arquitectura robusta y control de acceso seguro.</p>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 feature-card">
                <div class="card-body">
                    <div class="feature-icon bg-primary-subtle text-primary rounded-circle mx-auto mb-3">
                        <i class="bi bi-laptop fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Control de Inventario</h5>
                    <p class="text-muted small mb-0">
                        Administración detallada de equipos de Cómputo, Electrónica y Redes, con seguimiento de estados y calibración técnica.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 feature-card">
                <div class="card-body">
                    <div class="feature-icon bg-success-subtle text-success rounded-circle mx-auto mb-3">
                        <i class="bi bi-calendar-check fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Gestión de Reservas</h5>
                    <p class="text-muted small mb-0">
                        Validación automática de solapamientos horarios, control de turnos y aprobación de solicitudes por parte de los encargados.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 feature-card">
                <div class="card-body">
                    <div class="feature-icon bg-warning-subtle text-warning rounded-circle mx-auto mb-3">
                        <i class="bi bi-shield-lock fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Seguridad y Roles</h5>
                    <p class="text-muted small mb-0">
                        Autenticación cifrada con PBKDF2, protección contra accesos no autorizados, bloqueos por intentos fallidos y penalizaciones automáticas.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección Informativa / Módulos -->
    <div class="row align-items-center bg-white rounded-4 shadow-sm p-4 p-md-5 mb-4 border">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h3 class="fw-bold text-dark mb-3">¿Cómo funciona LabTrack?</h3>
            <p class="text-muted">
                LabTrack optimiza el flujo operativo entre estudiantes y administradores de laboratorio mediante dos perfiles claramente diferenciados:
            </p>
            <ul class="list-unstyled text-secondary">
                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i><strong>Estudiantes:</strong> Pueden explorar el catálogo por categorías, verificar la disponibilidad de los equipos y solicitar reservas en horarios libres de cruces.</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i><strong>Encargados:</strong> Administran el inventario tecnológico, supervisan la bandeja de solicitudes y registran devoluciones con control de puntualidad.</li>
            </ul>
        </div>
        <div class="col-lg-6 text-center">
            <div class="p-4 rounded-4 bg-light border">
                <i class="bi bi-building-gear display-1 text-primary opacity-75"></i>
                <h5 class="fw-bold text-dark mt-3">Infraestructura Tecnológica</h5>
                <p class="text-muted small mb-0">Desarrollado en ASP.NET Core MVC con Entity Framework y SQL Server.</p>
            </div>
        </div>
    </div>
</div>

<!-- Estilos CSS Personalizados -->
<style>
    .hero-section {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    }

    .feature-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }

    .feature-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
    }

    .bg-primary-subtle { background-color: #e0f2fe !important; }
    .bg-success-subtle { background-color: #dcfce7 !important; }
    .bg-warning-subtle { background-color: #fef9c3 !important; }
</style>
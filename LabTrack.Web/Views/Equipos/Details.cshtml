@model LabTrack.Web.Models.Equipo
@{
    ViewData["Title"] = "Detalle del equipo";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-info-circle text-primary me-2"></i> Detalle del Equipo</h2>
            <p class="text-muted mb-0">Información completa del equipo seleccionado.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Nombre</dt>
                <dd class="col-sm-9 fw-semibold">@Model.Nombre</dd>

                <dt class="col-sm-3 text-muted">Código de inventario</dt>
                <dd class="col-sm-9 font-monospace">@Model.CodigoInventario</dd>

                <dt class="col-sm-3 text-muted">Categoría</dt>
                <dd class="col-sm-9">@Model.Categoria</dd>

                <dt class="col-sm-3 text-muted">Estado</dt>
                <dd class="col-sm-9">@Model.Estado</dd>

                <dt class="col-sm-3 text-muted">Última calibración</dt>
                <dd class="col-sm-9">@Model.FechaUltimaCalibracion.ToString("dd/MM/yyyy")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-3">
            <i class="bi bi-pencil-square me-1"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-3">
            <i class="bi bi-trash me-1"></i> Eliminar
        </a>
    </div>
</div>

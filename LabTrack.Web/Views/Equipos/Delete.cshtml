@model LabTrack.Web.Models.Equipo
@{
    ViewData["Title"] = "Eliminar equipo";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-danger mb-1"><i class="bi bi-trash text-danger me-2"></i> Eliminar Equipo</h2>
            <p class="text-muted mb-0">Esta acción no se puede deshacer.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="alert alert-warning rounded-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                ¿Confirma que desea eliminar el siguiente equipo del inventario?
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Nombre</dt>
                <dd class="col-sm-9 fw-semibold">@Model.Nombre</dd>

                <dt class="col-sm-3 text-muted">Código de inventario</dt>
                <dd class="col-sm-9 font-monospace">@Model.CodigoInventario</dd>

                <dt class="col-sm-3 text-muted">Categoría</dt>
                <dd class="col-sm-9">@Model.Categoria</dd>

                <dt class="col-sm-3 text-muted">Estado</dt>
                <dd class="col-sm-9">@Model.Estado</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger rounded-3 px-4">
                    <i class="bi bi-trash me-1"></i> Eliminar definitivamente
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
            </form>
        </div>
    </div>
</div>

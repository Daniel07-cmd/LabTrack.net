@model LabTrack.Web.Models.Equipo
@{
    ViewData["Title"] = "Registrar equipo";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-plus-square text-primary me-2"></i> Registrar Nuevo Equipo</h2>
            <p class="text-muted mb-0">Complete los datos del equipo que ingresará al inventario.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CodigoInventario" class="form-label fw-semibold"></label>
                        <input asp-for="CodigoInventario" class="form-control" />
                        <span asp-validation-for="CodigoInventario" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Categoria" class="form-label fw-semibold"></label>
                        <select asp-for="Categoria" class="form-select">
                            <option value="">Seleccione una categoría...</option>
                            <option value="Cómputo">Cómputo</option>
                            <option value="Electrónica">Electrónica</option>
                            <option value="Redes">Redes</option>
                        </select>
                        <span asp-validation-for="Categoria" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Estado" class="form-label fw-semibold"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Disponible">Disponible</option>
                            <option value="Prestado">Prestado</option>
                            <option value="En Mantenimiento">En Mantenimiento</option>
                            <option value="Fuera de Servicio">Fuera de Servicio</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaUltimaCalibracion" class="form-label fw-semibold"></label>
                        <input asp-for="FechaUltimaCalibracion" class="form-control" type="date" />
                        <span asp-validation-for="FechaUltimaCalibracion" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="bi bi-save me-1"></i> Guardar equipo
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LabTrack.Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LabTrack.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    @{
        var usuarioNombre = Context.Session.GetString("UsuarioNombre");
        var usuarioRol = Context.Session.GetString("UsuarioRol");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cpu-fill text-primary me-2"></i>LabTrack<span class="text-primary">.Web</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-2">
                        <li class="nav-item">
                            <a class="nav-link text-light fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        @if (usuarioRol == "Encargado")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light fw-semibold" asp-area="" asp-controller="Equipos" asp-action="Index">
                                    <i class="bi bi-tools me-1"></i> Gestión de Equipos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light fw-semibold" asp-area="" asp-controller="GestionReservas" asp-action="Index">
                                    <i class="bi bi-calendar2-check me-1"></i> Reservas
                                </a>
                            </li>
                        }
                        else if (usuarioRol == "Estudiante")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light fw-semibold" asp-area="" asp-controller="Catalogo" asp-action="Index">
                                    <i class="bi bi-grid-3x3-gap-fill me-1"></i> Catálogo
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(usuarioNombre))
                        {
                            <span class="navbar-text text-white-50 small">
                                <i class="bi bi-person-circle text-success me-1"></i>@usuarioNombre (@usuarioRol)
                            </span>
                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-3">
                                <i class="bi bi-box-arrow-right me-1"></i> Salir
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm rounded-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto shadow-sm">
        <div class="container text-center">
            &copy; 2026 - LabTrack.Web — Sistema de Gestión de Laboratorios
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
